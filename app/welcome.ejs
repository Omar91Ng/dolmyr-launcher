<div id="welcomeContainer" style="display: none;">
    <div id="welcomeContent">
        <div class="dolmyrBienvenidaArte dolmGuia dolmGuiaGrande">
            <div class="dolmFigura">
                <div class="dolmSombra"></div>
                <img class="dolmRespaldo dolmyrBienvenidaDolm" src="assets/images/dolm.png" alt="" draggable="false"/>
            </div>
        </div>
        <div class="dolmyrBienvenidaTexto">
            <img id="welcomeImageSeal" src="assets/images/SealCircle.png" style="display: none;"/>
            <span id="welcomeHeader" class="dolmyrLogo">D<span class="dolmyrO">O</span>LMYR</span>
            <span class="dolmyrSubtituloMarca"><%- lang('dolmyr.subtitulo') %></span>
            <div class="dolmyrOrnamento"></div>
            <span id="welcomeDescription"><%- lang('welcome.welcomeDescription') %></span>
            <span id="welcomeDescCTA"><%- lang('welcome.welcomeDescCTA') %></span>
            <button id="welcomeButton">
                <div id="welcomeButtonContent">
                    <%- lang('welcome.continueButton') %>
                    <svg id="welcomeSVG" viewBox="0 0 24.87 13.97">
                        <defs>
                            <style>.arrowLine{fill:none;stroke:#FFF;stroke-width:2px;transition: 0.25s ease;}</style>
                        </defs>
                        <polyline class="arrowLine" points="0.71 13.26 12.56 1.41 24.16 13.02"/>
                    </svg>
                </div>
            </button>
        </div>
    </div>
    <script src="./assets/js/scripts/welcome.js"></script>
</div>
